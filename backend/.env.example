APP_NAME=DataPilot
APP_ENV=development
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
DATA_STORAGE_DIR=./storage
# Option 1: set a full MySQL URL (URL-encode special characters in credentials).
# DATABASE_URL=mysql+pymysql://datapilot_user:change-me@127.0.0.1:3306/datapilot
# Option 2: set all MYSQL_* values below.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=datapilot
MYSQL_USER=datapilot_user
MYSQL_PASSWORD=datapilot_pass
